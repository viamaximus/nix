# Full-screen filter (Hyprland decoration.screen_shader), two variants:
#   mono - every pixel reduced to its brightness and repainted on a ramp
#          between the palette's background and foreground colours (phosphor
#          / e-paper look; pages, images and video included), plus the CRT pass
#   crt  - only the CRT pass (scanlines, glow, aperture grille, vignette)
#
# The mono shader is a Noctalia template, so a palette switch re-renders it in
# the new colours and reloads it. Super+Shift+G (`screen-filter toggle`)
# switches between the two; the choice survives logout.
#
# Hyprland points at ~/.config/hypr/shaders/t1200-active.frag, a symlink that
# `screen-filter` aims at whichever variant is selected.
{
  config,
  lib,
  pkgs,
  ...
}: let
  cfg = config.t1200.retro;
  term = cfg.palettes.${cfg.scheme}.${cfg.palettes.${cfg.scheme}.mode}.terminal;

  shaderDir = "${config.xdg.configHome}/hypr/shaders";
  active = "${shaderDir}/t1200-active.frag";
  monoOut = "${shaderDir}/t1200-mono.frag";

  # "#ffb000" -> "255.0, 176.0, 0.0"
  hexToVec = hex: let
    h = lib.removePrefix "#" hex;
    ch = i: "${toString (lib.fromHexString (builtins.substring i 2 h))}.0";
  in "${ch 0}, ${ch 2}, ${ch 4}";

  # Static only (no `time` uniform), so damage tracking stays on and the
  # filter costs next to nothing. No curvature: the bezel crop would clip it.
  mkShader = {
    mono,
    bg ? "",
    fg ? "",
    hi ? "",
  }: ''
    #version 300 es
    // t1200 screen filter (${
      if mono
      then "mono"
      else "crt"
    }) - generated by hosts/t1200/retro/screen-filter.nix
    precision mediump float;
    in vec2 v_texcoord;
    layout(location = 0) out vec4 fragColor;
    uniform sampler2D tex;

    const float SCANLINE = 0.22;  // darkening of the dark row in each scanline (0 = off)
    const float PITCH    = 3.0;   // scanline height in pixels (2 lit rows + 1 dark)
    const float GLOW     = 0.12;  // horizontal phosphor bleed
    const float VIGNETTE = 0.18;  // corner falloff
    const float MASK     = 0.03;  // RGB aperture-grille tint per column
    ${lib.optionalString mono ''
      // ramp: background -> foreground -> highlight (palette bright-white)
      const vec3  BG       = vec3(${bg}) / 255.0;
      const vec3  FG       = vec3(${fg}) / 255.0;
      const vec3  HI       = vec3(${hi}) / 255.0;
      const float MONO     = 1.0;   // 1 = fully mapped onto the palette, 0 = original colours
      const float CONTRAST = 0.0;   // S-curve within each ramp segment (0 = linear, 1 = strong)
    ''}
    float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

    void main() {
        vec2 px = 1.0 / vec2(textureSize(tex, 0));
        vec3 c  = texture(tex, v_texcoord).rgb;

        // phosphor bleed: a little of the neighbouring pixels
        vec3 side = texture(tex, v_texcoord + vec2(px.x, 0.0)).rgb
                  + texture(tex, v_texcoord - vec2(px.x, 0.0)).rgb;
        c = mix(c, max(c, side * 0.5), GLOW);
    ${lib.optionalString mono ''

        // gradient map: brightness -> palette ramp. The stops sit at the
        // palette colours' own brightness, so anything already in the palette
        // (the terminal) maps to itself; only brighter-than-foreground content
        // (white pages) heads toward the highlight. On light palettes (LCD
        // light) the ramp runs ink -> paper -> highlight, so pages stay paper.
        bool  light = luma(BG) > luma(FG);
        vec3  lo  = light ? FG : BG;
        vec3  mid = light ? BG : FG;
        float L   = luma(c);
        float lL  = luma(lo);
        float mL  = luma(mid);
        float t;
        vec3  ramp;
        if (L <= mL) {
            t = clamp((L - lL) / max(mL - lL, 0.001), 0.0, 1.0);
            t = mix(t, t * t * (3.0 - 2.0 * t), CONTRAST);
            ramp = mix(lo, mid, t);
        } else {
            t = clamp((L - mL) / max(1.0 - mL, 0.001), 0.0, 1.0);
            t = mix(t, t * t * (3.0 - 2.0 * t), CONTRAST);
            ramp = mix(mid, HI, t);
        }
        c = mix(c, ramp, MONO);
    ''}
        // scanlines: last row of every PITCH-pixel band dimmed, the row before
        // it slightly, so the line reads as a soft gap rather than a stripe
        float row = floor(mod(gl_FragCoord.y, PITCH));
        c *= 1.0 - SCANLINE * (step(PITCH - 1.0, row) + 0.35 * step(PITCH - 2.0, row) * (1.0 - step(PITCH - 1.0, row)));

        // aperture grille
        int col = int(mod(gl_FragCoord.x, 3.0));
        vec3 mask = vec3(1.0 - MASK);
        mask[col] = 1.0 + MASK;
        c *= mask;

        // vignette
        vec2 d = v_texcoord - 0.5;
        c *= 1.0 - VIGNETTE * dot(d, d) * 2.0;

        fragColor = vec4(c, 1.0);
    }
  '';

  crtShader = pkgs.writeText "t1200-crt.frag" (mkShader {mono = false;});

  # Rendered by Noctalia with the live palette.
  monoTemplate = mkShader {
    mono = true;
    bg = "{{colors.terminal_background.default.red}}.0, {{colors.terminal_background.default.green}}.0, {{colors.terminal_background.default.blue}}.0";
    fg = "{{colors.terminal_foreground.default.red}}.0, {{colors.terminal_foreground.default.green}}.0, {{colors.terminal_foreground.default.blue}}.0";
    hi = "{{colors.terminal_bright_white.default.red}}.0, {{colors.terminal_bright_white.default.green}}.0, {{colors.terminal_bright_white.default.blue}}.0";
  };

  # Same, pre-filled with the default scheme: seeds the file before Noctalia
  # has rendered it once (first login), so Hyprland always finds a shader.
  monoSeed = pkgs.writeText "t1200-mono.frag" (mkShader {
    mono = true;
    bg = hexToVec term.background;
    fg = hexToVec term.foreground;
    hi = hexToVec term.bright.white;
  });

  screenFilter = pkgs.writeShellApplication {
    name = "screen-filter";
    runtimeInputs = with pkgs; [coreutils hyprland];
    text = ''
      # usage: screen-filter [toggle|mono|crt|reload|link]
      state="''${XDG_STATE_HOME:-$HOME/.local/state}/t1200/screen-filter"
      mkdir -p "$(dirname "$state")" "${shaderDir}"
      [ -f "${monoOut}" ] || install -m644 ${monoSeed} "${monoOut}"

      mode=$(cat "$state" 2>/dev/null || echo mono)
      case "''${1:-reload}" in
        toggle) [ "$mode" = mono ] && mode=crt || mode=mono ;;
        mono | crt) mode=$1 ;;
        reload | link) ;;
        *) echo "usage: screen-filter [toggle|mono|crt|reload|link]" >&2; exit 2 ;;
      esac
      echo "$mode" > "$state"

      if [ "$mode" = mono ]; then target="${monoOut}"; else target="${crtShader}"; fi
      ln -sfn "$target" "${active}"

      # Hyprland only re-reads the shader when the option value changes, so
      # blank it and set it back. Skipped outside a Hyprland session.
      [ "''${1:-reload}" = link ] && exit 0
      [ -n "''${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || exit 0
      hyprctl eval 'hl.config({ decoration = { screen_shader = "" } })' >/dev/null
      hyprctl eval 'hl.config({ decoration = { screen_shader = "${active}" } })' >/dev/null
    '';
  };
in {
  home.packages = [screenFilter];

  # Make sure the active symlink exists before Hyprland starts.
  home.activation.screenFilter = lib.hm.dag.entryAfter ["writeBoundary"] ''
    run ${screenFilter}/bin/screen-filter link
  '';

  wayland.windowManager.hyprland.settings.config.decoration.screen_shader = active;

  xdg.configFile."noctalia/templates/t1200/screen-mono.frag".text = monoTemplate;

  programs.noctalia.settings.theme.templates.user.t1200_screen = {
    input_path = "${config.xdg.configHome}/noctalia/templates/t1200/screen-mono.frag";
    output_path = "$XDG_CONFIG_HOME/hypr/shaders/t1200-mono.frag";
    post_hook = "${screenFilter}/bin/screen-filter reload";
  };
}
